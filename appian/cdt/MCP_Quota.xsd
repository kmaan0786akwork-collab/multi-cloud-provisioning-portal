<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="urn:com:appian:types:MCP" targetNamespace="urn:com:appian:types:MCP">
  <xsd:complexType name="MCP_Quota">
    <xsd:annotation>
      <xsd:documentation>Resource boundaries and monthly budget for a team</xsd:documentation>
      <xsd:appinfo source="appian.jpa">@Table(name="MCP_QUOTA")</xsd:appinfo>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="quotaId" nillable="true" type="xsd:int">
        <xsd:annotation><xsd:appinfo source="appian.jpa">@Id @GeneratedValue @Column(name="QUOTA_ID", nullable=false)</xsd:appinfo></xsd:annotation>
      </xsd:element>
      <xsd:element name="teamId" nillable="true" type="xsd:string">
        <xsd:annotation><xsd:appinfo source="appian.jpa">@Column(name="TEAM_ID", length=10)</xsd:appinfo></xsd:annotation>
      </xsd:element>
      <xsd:element name="vcpuLimit" nillable="true" type="xsd:int">
        <xsd:annotation><xsd:appinfo source="appian.jpa">@Column(name="VCPU_LIMIT")</xsd:appinfo></xsd:annotation>
      </xsd:element>
      <xsd:element name="ramLimitGb" nillable="true" type="xsd:int">
        <xsd:annotation><xsd:appinfo source="appian.jpa">@Column(name="RAM_LIMIT_GB")</xsd:appinfo></xsd:annotation>
      </xsd:element>
      <xsd:element name="storageLimitGb" nillable="true" type="xsd:int">
        <xsd:annotation><xsd:appinfo source="appian.jpa">@Column(name="STORAGE_LIMIT_GB")</xsd:appinfo></xsd:annotation>
      </xsd:element>
      <xsd:element name="monthlyBudget" nillable="true" type="xsd:decimal">
        <xsd:annotation><xsd:appinfo source="appian.jpa">@Column(name="MONTHLY_BUDGET")</xsd:appinfo></xsd:annotation>
      </xsd:element>
      <xsd:element name="updatedBy" nillable="true" type="xsd:string">
        <xsd:annotation><xsd:appinfo source="appian.jpa">@Column(name="UPDATED_BY", length=255)</xsd:appinfo></xsd:annotation>
      </xsd:element>
      <xsd:element name="updatedOn" nillable="true" type="xsd:dateTime">
        <xsd:annotation><xsd:appinfo source="appian.jpa">@Column(name="UPDATED_ON")</xsd:appinfo></xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>
